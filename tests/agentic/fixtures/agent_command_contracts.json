      {
        "name": "domain",
        "type": "string",
        "default": ""
      },
      {
        "name": "limit",
        "type": "int",
        "default": "5"
      },
      {
        "name": "query",
        "type": "string",
        "default": "",
        "required": true
      }
    ]
  },
  {
    "path": "agent-search",
    "use": "agent-search --query <text>",
    "flags": [
      {
        "name": "domain",
        "type": "string",
        "default": ""
      },
      {
        "name": "limit",
        "type": "int",
        "default": "10"
      },
      {
        "name": "query",
        "type": "string",
        "default": "",
        "required": true
      }
    ]
  }
]
