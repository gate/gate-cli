[
  {
    "path": "agent-index",
    "use": "agent-index",
    "flags": [
      {
        "name": "command",
        "type": "string",
        "default": ""
      },
      {
        "name": "details",
        "type": "bool",
        "default": "false"
      },
      {
        "name": "domain",
        "type": "string",
        "default": ""
      }
    ]
  },
  {
    "path": "agent-resolve",
    "use": "agent-resolve --query <text>",
