# Integration test configuration — copy to integration.yaml and fill in your keys.
# Uses Gate testnet by default: https://api-testnet.gateapi.io
#
# Copy: cp testdata/integration.yaml.example testdata/integration.yaml
# integration.yaml is gitignored and will never be committed.

default_profile: testnet
default_settle: usdt

profiles:
  testnet:
    api_key: "YOUR_TESTNET_API_KEY"
    api_secret: "YOUR_TESTNET_API_SECRET"
    base_url: "https://api-testnet.gateapi.io"

# --- Intel / MCP (optional)
# See README.md and docs/quickstart.md for public configuration fields.
# Non-empty GATE_INTEL_* environment values override file values.
# GATE_INTEL_NEWS_MCP_URL=https://api.gatemcp.ai/mcp/news
# GATE_INTEL_INFO_MCP_URL=https://api.gatemcp.ai/mcp/info
# Supply authorized bearer credentials locally; never commit their values.
# GATE_INTEL_HTTP_TIMEOUT=60s
